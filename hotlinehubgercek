    createCorner(btnFrame, 8)

    local icon = Instance.new("ImageLabel")
    icon.Name = "Icon"
    icon.Size = UDim2.new(0, 18, 0, 18)
    icon.Position = UDim2.new(0, 14, 0.5, -9)
    icon.BackgroundTransparency = 1
    icon.Image = iconAssetId
    icon.ImageColor3 = Theme.TextMuted
    icon.Parent = btnFrame

    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Size = UDim2.new(1, -48, 1, 0)
    label.Position = UDim2.new(0, 44, 0, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.Text = name
    label.TextColor3 = Theme.TextMuted
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = btnFrame

    navButtons[name] = { Frame = btnFrame, Label = label, Icon = icon }

    btnFrame.MouseButton1Click:Connect(function()
        switchTab(name)
    end)
    
    btnFrame.MouseEnter:Connect(function()
        if activeTab ~= name then
            tween(btnFrame, { BackgroundColor3 = Theme.CardBg }, 0.2)
            tween(label, { TextColor3 = Theme.TextWhite }, 0.2)
            tween(icon, { ImageColor3 = Theme.AccentYellow }, 0.2)
        end
    end)
    btnFrame.MouseLeave:Connect(function()
        if activeTab ~= name then
            tween(btnFrame, { BackgroundColor3 = Color3.fromRGB(0, 0, 0, 0) }, 0.2)
            tween(label, { TextColor3 = Theme.TextMuted }, 0.2)
            tween(icon, { ImageColor3 = Theme.TextMuted }, 0.2)
        end
    end)
end

