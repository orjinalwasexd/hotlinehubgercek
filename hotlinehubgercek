local function detectExecutor()
    local name = (identifyexecutor and identifyexecutor()) or (getexecutorname and getexecutorname())
    if name and tostring(name) ~= "" then
        return tostring(name)
    end
    if syn then return "Synapse X" end
    if KRNL_LOADED then return "Krnl" end
    if fluxus then return "Fluxus" end
    if is_delta_closure or delta then return "Delta" end
    if codex then return "Codex" end
    if arceus then return "Arceus X" end
    if shadow_loaded then return "Shadow" end
    if is_sirhurt_closure then return "SirHurt" end
    if pebc_execute then return "ProtoSmasher" end
    if SENTINEL_LOADED then return "Sentinel" end
    if OXYGEN_LOADED then return "Oxygen U" end
    return "Universal"
end

