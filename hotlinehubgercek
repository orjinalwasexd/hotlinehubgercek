local function executeGameScript(gameEntry)
    if not gameEntry then return end

    if gameEntry.Key and gameEntry.Key ~= "" then
        if setclipboard then
            pcall(function() setclipboard(gameEntry.Key) end)
        end
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Hotline Hub",
                Text = gameEntry.Name .. " Key kopyalandı: " .. gameEntry.Key,
                Duration = 5
            })
        end)
    end

    tween(MainFrame, {
        Size = UDim2.new(0, 700, 0, 390),
        BackgroundTransparency = 1
    }, 0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

    task.wait(0.26)
    HotlineHubGui:Destroy()

    task.spawn(function()
        if type(gameEntry.Execute) == "function" then
            gameEntry.Execute()
        end
    end)
end

