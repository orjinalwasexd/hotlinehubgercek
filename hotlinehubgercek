local function renderGames(filterText)
    for _, child in pairs(GamesContainer:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    for _, gameData in ipairs(GamesList) do
        local matches = true
        if filterText and filterText ~= "" then
            matches = string.find(string.lower(gameData.Name), string.lower(filterText)) or string.find(string.lower(gameData.Description), string.lower(filterText))
        end

        if matches then
            local isCurrentGame = false
            if gameData.PlaceIds then
                for _, pid in ipairs(gameData.PlaceIds) do
                    if pid == game.PlaceId then
                        isCurrentGame = true
                        break
                    end
                end
            end

            local Card = Instance.new("Frame")
            Card.Name = "GameCard_" .. gameData.Name
            Card.Size = UDim2.new(1, 0, 0, 100)
            Card.BackgroundColor3 = Theme.CardBg
            Card.BorderSizePixel = 0
            Card.Parent = GamesContainer
            createCorner(Card, 12)
            
            if isCurrentGame then
                createStroke(Card, Theme.AccentYellow, 1.4)
            else
                createStroke(Card, Theme.CardBorder, 1)
            end

            local ThumbContainer = Instance.new("Frame")
            ThumbContainer.Name = "ThumbContainer"
            ThumbContainer.Size = UDim2.new(0, 120, 0, 74)
            ThumbContainer.Position = UDim2.new(0, 14, 0.5, -37)
            ThumbContainer.BackgroundColor3 = Theme.CardBgLighter
            ThumbContainer.BorderSizePixel = 0
            ThumbContainer.ClipsDescendants = true
            ThumbContainer.Parent = Card
            createCorner(ThumbContainer, 8)

            local ThumbPlaceholder = Instance.new("ImageLabel")
            ThumbPlaceholder.Name = "ThumbPlaceholder"
            ThumbPlaceholder.Size = UDim2.new(0, 32, 0, 32)
            ThumbPlaceholder.Position = UDim2.new(0.5, -16, 0.5, -16)
            ThumbPlaceholder.BackgroundTransparency = 1
            ThumbPlaceholder.Image = Icons.Games
            ThumbPlaceholder.ImageColor3 = Theme.AccentYellow
            ThumbPlaceholder.ZIndex = 1
            ThumbPlaceholder.Parent = ThumbContainer

            local thumbUrl = gameData.Thumbnail or ""
            if thumbUrl == "" and gameData.UniverseId then
                thumbUrl = "rbxthumb://type=GameIcon&id=" .. tostring(gameData.UniverseId) .. "&w=150&h=150"
            end

            local ThumbImage = Instance.new("ImageLabel")
            ThumbImage.Name = "ThumbImage"
            ThumbImage.Size = UDim2.new(1, 0, 1, 0)
            ThumbImage.BackgroundTransparency = 1
            ThumbImage.ZIndex = 2
            ThumbImage.ScaleType = Enum.ScaleType.Crop
            ThumbImage.Image = thumbUrl
            ThumbImage.Parent = ThumbContainer
            createCorner(ThumbImage, 8)

            ThumbImage:GetPropertyChangedSignal("IsLoaded"):Connect(function()
                if ThumbImage.IsLoaded then
                    ThumbPlaceholder.Visible = false
                end
            end)
            if ThumbImage.IsLoaded then
                ThumbPlaceholder.Visible = false
            end

            if thumbUrl == "" and gameData.PlaceIds and #gameData.PlaceIds > 0 then
                local pid = gameData.PlaceIds[1]
                task.spawn(function()
                    pcall(function()
                        local raw = game:HttpGet("https://apis.roblox.com/universes/v1/places/" .. tostring(pid) .. "/universe")
                        local parsed = HttpService:JSONDecode(raw)
                        if parsed and parsed.universeId then
                            gameData.UniverseId = parsed.universeId
                            gameData.Thumbnail = "rbxthumb://type=GameIcon&id=" .. tostring(parsed.universeId) .. "&w=150&h=150"
                            ThumbImage.Image = gameData.Thumbnail
                        end
                    end)
                end)
            end

            local TitleLabel = Instance.new("TextLabel")
            TitleLabel.Name = "TitleLabel"
            TitleLabel.Size = UDim2.new(0.55, 0, 0, 22)
            TitleLabel.Position = UDim2.new(0, 146, 0, 12)
            TitleLabel.BackgroundTransparency = 1
            TitleLabel.Font = Enum.Font.GothamBlack
            TitleLabel.Text = gameData.Name
            TitleLabel.TextColor3 = Theme.TextWhite
            TitleLabel.TextSize = 16
            TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
            TitleLabel.Parent = Card

            local SubRow = Instance.new("Frame")
            SubRow.Name = "SubRow"
            SubRow.Size = UDim2.new(0.55, 0, 0, 20)
            SubRow.Position = UDim2.new(0, 146, 0, 36)
            SubRow.BackgroundTransparency = 1
            SubRow.Parent = Card

            local SubRowLayout = Instance.new("UIListLayout")
            SubRowLayout.FillDirection = Enum.FillDirection.Horizontal
            SubRowLayout.Padding = UDim.new(0, 8)
            SubRowLayout.VerticalAlignment = Enum.VerticalAlignment.Center
            SubRowLayout.Parent = SubRow

            local IdLabel = Instance.new("TextLabel")
            IdLabel.Name = "IdLabel"
            IdLabel.Size = UDim2.new(0, 0, 1, 0)
            IdLabel.AutomaticSize = Enum.AutomaticSize.X
            IdLabel.BackgroundTransparency = 1
            IdLabel.Font = Enum.Font.GothamBold
            IdLabel.Text = "ID: " .. tostring(gameData.PlaceIds and gameData.PlaceIds[1] or "Universal")
            IdLabel.TextColor3 = Theme.TextMuted
            IdLabel.TextSize = 11
            IdLabel.Parent = SubRow

            if isCurrentGame then
                local GameStatusBadge = Instance.new("TextLabel")
                GameStatusBadge.Name = "GameStatusBadge"
                GameStatusBadge.Size = UDim2.new(0, 0, 0, 18)
                GameStatusBadge.AutomaticSize = Enum.AutomaticSize.X
                GameStatusBadge.BackgroundColor3 = Color3.fromRGB(25, 45, 25)
                GameStatusBadge.Font = Enum.Font.GothamBold
                GameStatusBadge.Text = " • Bu Oyundasınız "
                GameStatusBadge.TextColor3 = Theme.SuccessGreen
                GameStatusBadge.TextSize = 11
                GameStatusBadge.Parent = SubRow
                createCorner(GameStatusBadge, 4)
            end

            if gameData.Key and gameData.Key ~= "" then
                local GameKeyBadge = Instance.new("TextLabel")
                GameKeyBadge.Name = "GameKeyBadge"
                GameKeyBadge.Size = UDim2.new(0, 0, 0, 18)
                GameKeyBadge.AutomaticSize = Enum.AutomaticSize.X
                GameKeyBadge.BackgroundColor3 = Color3.fromRGB(48, 40, 15)
                GameKeyBadge.Font = Enum.Font.GothamBlack
                GameKeyBadge.Text = " 🔑 Key: " .. gameData.Key .. " "
                GameKeyBadge.TextColor3 = Theme.AccentYellow
                GameKeyBadge.TextSize = 11
                GameKeyBadge.Parent = SubRow
                createCorner(GameKeyBadge, 4)
            end

            local DescLabel = Instance.new("TextLabel")
            DescLabel.Name = "DescLabel"
            DescLabel.Size = UDim2.new(0.55, 0, 0, 20)
            DescLabel.Position = UDim2.new(0, 146, 0, 62)
            DescLabel.BackgroundTransparency = 1
            DescLabel.Font = Enum.Font.GothamMedium
            DescLabel.Text = gameData.Description .. (gameData.Key and " (Key otomatik kopyalanır)" or "")
            DescLabel.TextColor3 = Theme.TextMuted
            DescLabel.TextSize = 11
            DescLabel.TextTruncate = Enum.TextTruncate.AtEnd
            DescLabel.TextXAlignment = Enum.TextXAlignment.Left
            DescLabel.Parent = Card

            local ExecButton = Instance.new("TextButton")
            ExecButton.Name = "ExecButton"
            ExecButton.Size = UDim2.new(0, 120, 0, 36)
            ExecButton.Position = UDim2.new(1, -135, 0.5, -18)
            ExecButton.AutoButtonColor = false
            ExecButton.BackgroundColor3 = Theme.AccentYellow
            ExecButton.Font = Enum.Font.GothamBlack
            ExecButton.Text = "Çalıştır ▶"
            ExecButton.TextColor3 = Theme.TextDark
            ExecButton.TextSize = 13
            ExecButton.Parent = Card
            createCorner(ExecButton, 8)

            ExecButton.MouseEnter:Connect(function()
                tween(ExecButton, { BackgroundColor3 = Theme.AccentGlow }, 0.15)
            end)
            ExecButton.MouseLeave:Connect(function()
                tween(ExecButton, { BackgroundColor3 = Theme.AccentYellow }, 0.15)
            end)

            ExecButton.MouseButton1Click:Connect(function()
                executeGameScript(gameData)
            end)
        end
    end
end

